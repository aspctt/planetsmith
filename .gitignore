###############################################################################
# Planetsmith - .gitignore for a C# / .NET RimWorld (Harmony) mod
###############################################################################

## Release archives
# Built by zipping the Mod folder for a release. Regenerated on demand, so there
# is no reason to carry them in history where they would bloat every clone.
*.zip
*.7z
*.rar
Release/
Releases/
build/

## .NET build intermediates and output
[Bb]in/
[Oo]bj/
*.binlog
msbuild*.log

# The compiled mod assembly lives in Mod/1.6/Assemblies/ and ships with the mod,
# so it is intentionally TRACKED (the .csproj OutputPath points there). Reference
# DLLs are not copied in (Private=false), so nothing else lands there.

## Debug symbols (DebugType=none by default, so normally none are produced)
*.pdb
*.mdb

## IDE / editor cruft
.vs/
.vscode/
.idea/
*.suo
*.user
*.userprefs
*.DotSettings.user
_ReSharper*/

## NuGet
*.nupkg
*.snupkg

## OS cruft
.DS_Store
Thumbs.db
desktop.ini

###############################################################################
# Local-only reference material. NOT for publication.
#
# Holds bug reports, test logs, art sources, and third-party and decompiled
# code / binaries that must not be redistributed with this GPL mod. Kept locally
# for reference and never committed.
###############################################################################
external-files/

## Test harness
# The runner's assembly is rebuilt by every test run, and the output folder holds the
# test save data, logs and results of each run. Baselines in tests/baselines are kept.
tests/RunnerMod/1.6/Assemblies/
tests/output/
