<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Register Worldsmith's debug climate overlay as a draw layer on the surface planet layer. -->
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/PlanetLayerDef[defName="Surface"]/worldDrawLayers</xpath>
		<value>
			<li>Worldsmith.Overlay.WorldDrawLayer_WorldsmithClimate</li>
		</value>
	</Operation>
</Patch>
