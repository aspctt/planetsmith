<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Planetsmith.UnitTests</AssemblyName>
		<RootNamespace>Planetsmith.UnitTests</RootNamespace>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>nullable</WarningsAsErrors>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- Same defaults and overrides as src\Planetsmith.csproj. -->
	<PropertyGroup>
		<RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">S:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="NUnit" Version="3.14.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Unlike the mod, the tests run outside the game, so Unity's module is copied next
			to them. Only plain math runs here: Vector3 and Mathf's managed members. Anything
			that calls into the engine itself, or needs the game's world, belongs in the
			in-game test jobs instead.
		-->
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<!--
			Planetsmith always builds as Release here. Its project writes straight into
			Mod\1.6\Assemblies, so a Debug build from running the tests would replace the
			shipped assembly. The build is deterministic, so Release leaves it unchanged.
		-->
		<ProjectReference Include="..\..\src\Planetsmith.csproj">
			<SetConfiguration>Configuration=Release</SetConfiguration>
		</ProjectReference>
	</ItemGroup>

</Project>
